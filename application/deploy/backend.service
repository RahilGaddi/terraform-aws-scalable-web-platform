[Unit]
Description=Three Tier Demo Node.js Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/three-tier-app/backend
EnvironmentFile=/opt/three-tier-app/backend/.env
ExecStart=/usr/bin/node /opt/three-tier-app/backend/app.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
