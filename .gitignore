# Terraform working directory
**/.terraform/*

# Terraform state - never commit
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform plans may contain sensitive values
*.tfplan
*.plan

# Local variable files - may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI configuration
.terraformrc
terraform.rc

# Credentials and private keys
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
.aws/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Frontend build output
dist/
build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Test and coverage output
coverage/
.pytest_cache/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

.env
*.pem
*.key
terraform.tfstate
terraform.tfstate.*
.terraform/
